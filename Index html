<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MY HOME — Детский телеканал</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: #0a192f;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        .header {
            width: 100%;
            max-width: 1100px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0 20px 0;
            border-bottom: 2px solid #1e3a5f;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .header h1 { font-size: 2rem; letter-spacing: 2px; font-weight: 700; color: #ffffff; }
        .header h1 span { color: #ffd700; }
        .clock {
            background-color: #1e3a5f;
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #ffd700;
            letter-spacing: 1px;
        }
        .btn-admin-login {
            background-color: #ff6b6b;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 30px;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.3s;
        }
        .btn-admin-login:hover { background-color: #ff4444; transform: scale(1.05); }
        .main-container { width: 100%; max-width: 1100px; display: flex; flex-direction: column; gap: 30px; }
        .player-section {
            background-color: #112240;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
            border: 1px solid #1e3a5f;
            max-width: 100%;
        }
        .player-title { font-size: 1.4rem; margin-bottom: 15px; color: #ffd700; text-align: center; }
        .video-container {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            border-radius: 12px;
            background-color: #000;
            min-height: 300px;
        }
        .video-container iframe {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            border: none;
        }
        .schedule-container {
            background-color: #112240;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
            border: 1px solid #1e3a5f;
        }
        .schedule-title { text-align: center; font-size: 1.5rem; margin-bottom: 20px; color: #a0c4ff; letter-spacing: 1px; font-weight: 600; }
        .schedule-table { width: 100%; border-collapse: collapse; font-size: 1rem; }
        .schedule-table th {
            background-color: #1e3a5f;
            color: #ffffff;
            padding: 12px 15px;
            text-align: left;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            border-bottom: 2px solid #2a4a7a;
        }
        .schedule-table td { padding: 12px 15px; border-bottom: 1px solid #1e3a5f; }
        .time-cell { font-weight: 700; color: #ffd700; white-space: nowrap; min-width: 130px; }
        .show-cell { font-weight: 500; }
        .status {
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 700;
            white-space: nowrap;
            text-align: center;
            display: inline-block;
            min-width: 80px;
        }
        .status.active { background-color: #ff6b6b; color: white; }
        .status.upcoming { background-color: #2a4a7a; color: #a0c4ff; }
        .status.ended { background-color: #1a2f4a; color: #5a7a9a; }
        .notice { text-align: center; color: #5a7a9a; font-size: 0.85rem; margin-top: 15px; font-style: italic; }
        .footer { margin-top: 25px; font-size: 0.85rem; color: #5a7a9a; text-align: center; padding: 15px; }
        .admin-panel {
            display: none;
            background-color: #1a0a0a;
            border: 2px solid #ff6b6b;
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
        }
        .admin-panel.visible { display: block; }
        .admin-panel h3 { color: #ff6b6b; margin-bottom: 15px; text-align: center; }
        .admin-buttons { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
        .btn-admin {
            background-color: #2a4a7a;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .btn-admin:hover { background-color: #ff6b6b; }
        .btn-admin.active { background-color: #ff6b6b; }
        .btn-admin-logout {
            background-color: #ff6b6b;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.85rem;
            margin-top: 10px;
        }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.9);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        .modal-overlay.visible { display: flex !important; }
        .modal-box {
            background-color: #112240;
            border: 2px solid #ffd700;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            max-width: 400px;
            width: 90%;
        }
        .modal-box h3 { color: #ffd700; margin-bottom: 15px; }
        .modal-box input {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 2px solid #2a4a7a;
            background-color: #0a192f;
            color: white;
            font-size: 1.1rem;
            text-align: center;
            margin-bottom: 15px;
            outline: none;
        }
        .modal-box button {
            background-color: #ffd700;
            color: #0a192f;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 700;
            font-size: 1rem;
            margin: 5px;
        }
        .modal-box .btn-cancel { background-color: #2a4a7a; color: white; }
        .error-msg { color: #ff6b6b; font-size: 0.9rem; margin-top: 10px; display: none; }
        .error-msg.visible { display: block; }
        @media (max-width: 600px) {
            body { padding: 10px; }
            .header h1 { font-size: 1.5rem; }
            .schedule-table { font-size: 0.85rem; }
            .time-cell { min-width: 90px; font-size: 0.8rem; }
            .clock { font-size: 1rem; padding: 8px 15px; }
            .btn-admin { padding: 8px 12px; font-size: 0.75rem; }
            .video-container { min-height: 200px; }
            .btn-admin-login { padding: 8px 12px; font-size: 0.75rem; }
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>MY <span>HOME</span> 📺</h1>
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <div class="clock" id="clock">00:00:00</div>
            <button class="btn-admin-login" onclick="document.getElementById('modalOverlay').classList.add('visible')">🔐 Вход</button>
        </div>
    </div>

    <div class="main-container">
        <div class="player-section">
            <div class="player-title" id="playerTitle">⏳ Ожидание эфира...</div>
            <div class="video-container">
                <iframe id="videoFrame" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            </div>
            <div class="notice">🔒 Просмотр доступен только по расписанию</div>
        </div>

        <div class="admin-panel" id="adminPanel">
            <h3>🔐 Режим администратора</h3>
            <div class="admin-buttons" id="adminButtons"></div>
            <div style="text-align: center;">
                <button class="btn-admin-logout" onclick="logoutAdmin()">🚪 Выйти</button>
            </div>
        </div>

        <div class="schedule-container">
            <div class="schedule-title">📅 Расписание эфира</div>
            <table class="schedule-table">
                <thead><tr><th>Время</th><th>Мультфильм</th><th>Статус</th></tr></thead>
                <tbody id="scheduleBody"></tbody>
            </table>
        </div>
    </div>

    <div class="footer">MY HOME • Телеканал для детей</div>

    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-box">
            <h3>🔐 Введите пароль</h3>
            <input type="password" id="passwordInput" placeholder="Пароль..." onkeydown="if(event.key==='Enter')checkPassword()">
            <div>
                <button onclick="checkPassword()">Войти</button>
                <button class="btn-cancel" onclick="document.getElementById('modalOverlay').classList.remove('visible')">Отмена</button>
            </div>
            <div class="error-msg" id="errorMsg">❌ Неверный пароль!</div>
        </div>
    </div>

    <script>
        // ПРОСТОЙ СКРИПТ БЕЗ YOUTUBE API
        var ADMIN_PASSWORD = "28013";
        var schedule = [
            { start: { h: 6, m: 0 }, end: { h: 7, m: 30 }, title: "Губка Боб", videoIds: ["83gzUfs8VU4"] },
            { start: { h: 7, m: 30 }, end: { h: 8, m: 0 }, title: "Три кота", videoIds: ["C4sX4HvxgmY"] },
            { start: { h: 8, m: 0 }, end: { h: 9, m: 15 }, title: "Мими Мишки", videoIds: ["XEzMTmC1r1w"] },
            { start: { h: 9, m: 15 }, end: { h: 10, m: 0 }, title: "Медведь Валера", videoIds: ["C6Z2Zuq74gg", "mpjb-thhmeM"] },
            { start: { h: 10, m: 0 }, end: { h: 10, m: 30 }, title: "Ералаш", videoIds: ["PZSkHSWnu1g"] },
            { start: { h: 10, m: 30 }, end: { h: 12, m: 0 }, title: "Маша и Медведь", videoIds: ["dL2O7GMG3xQ"] },
            { start: { h: 12, m: 0 }, end: { h: 12, m: 30 }, title: "Дельфинёнок Муму", videoIds: ["YwGxJJAIf80"] },
            { start: { h: 12, m: 30 }, end: { h: 13, m: 15 }, title: "Барбоскины", videoIds: ["9CDdPPlsUkk"] },
            { start: { h: 13, m: 15 }, end: { h: 14, m: 0 }, title: "Baby Shark", videoIds: ["kjCfzGzqlWA"] }
        ];

        function pad(n){return String(n).padStart(2,'0')}
        function timeToMinutes(h,m){return h*60+m}
        function formatTime(h,m){return pad(h)+":"+pad(m)}
        
        // Часы
        function updateClock(){
            var now = new Date();
            document.getElementById('clock').textContent = pad(now.getHours())+":"+pad(now.getMinutes())+":"+pad(now.getSeconds());
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Построение расписания
        function buildSchedule(){
            var html = '';
            schedule.forEach(function(item){
                var id = item.title.replace(/\s+/g,'-');
                html += '<tr><td class="time-cell">'+formatTime(item.start.h,item.start.m)+' – '+formatTime(item.end.h,item.end.m)+'</td><td class="show-cell">'+item.title+'</td><td><span class="status upcoming" id="status-'+id+'">Ожидание</span></td></tr>';
            });
            document.getElementById('scheduleBody').innerHTML = html;
        }
        buildSchedule();

        // Проверка пароля
        function checkPassword(){
            var input = document.getElementById('passwordInput').value;
            if(input === ADMIN_PASSWORD){
                document.getElementById('modalOverlay').classList.remove('visible');
                document.getElementById('adminPanel').classList.add('visible');
                buildAdminButtons();
            } else {
                document.getElementById('errorMsg').classList.add('visible');
                document.getElementById('passwordInput').value = '';
            }
        }

        // Выход из админки
        function logoutAdmin(){
            document.getElementById('adminPanel').classList.remove('visible');
        }

        // Кнопки админа
        function buildAdminButtons(){
            var html = '';
            schedule.forEach(function(item, index){
                html += '<button class="btn-admin" onclick="playVideo('+index+',0)">'+item.title+'</button>';
            });
            document.getElementById('adminButtons').innerHTML = html;
        }

        // Включение видео
        function playVideo(index, videoIndex){
            var item = schedule[index];
            var videoId = item.videoIds[videoIndex];
            if(!videoId) return;
            document.getElementById('playerTitle').textContent = '▶ Сейчас идёт: ' + item.title;
            document.getElementById('videoFrame').src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
            
            // Обновление статусов
            schedule.forEach(function(s){
                var id = s.title.replace(/\s+/g,'-');
                var el = document.getElementById('status-'+id);
                if(s.title === item.title){
                    el.textContent = '▶ Идёт';
                    el.className = 'status active';
                }
            });
        }

        // Автопоказ по расписанию
        function checkSchedule(){
            var now = new Date();
            var nowMinutes = timeToMinutes(now.getHours(), now.getMinutes());
            
            for(var i = 0; i < schedule.length; i++){
                var item = schedule[i];
                var start = timeToMinutes(item.start.h, item.start.m);
                var end = timeToMinutes(item.end.h, item.end.m);
                
                if(nowMinutes >= start && nowMinutes < end){
                    var id = item.title.replace(/\s+/g,'-');
                    var statusEl = document.getElementById('status-'+id);
                    if(statusEl && statusEl.textContent !== '▶ Идёт'){
                        playVideo(i, 0);
                    }
                    return;
                }
            }
        }
        setInterval(checkSchedule, 30000);
        checkSchedule();
    </script>
</body>
</html>
