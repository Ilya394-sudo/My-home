<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MY HOME — Детский телеканал</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: #0a192f;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        .header {
            width: 100%;
            max-width: 1100px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0 20px 0;
            border-bottom: 2px solid #1e3a5f;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .header h1 { font-size: 2rem; letter-spacing: 2px; font-weight: 700; color: #ffffff; }
        .header h1 span { color: #ffd700; }
        .clock {
            background-color: #1e3a5f;
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 1.2rem;
            font-weight: 700;
            color: #ffd700;
        }
        .main-container { width: 100%; max-width: 1100px; display: flex; flex-direction: column; gap: 30px; }
        .player-section {
            background-color: #112240;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
            border: 1px solid #1e3a5f;
        }
        .player-title { font-size: 1.4rem; margin-bottom: 15px; color: #ffd700; text-align: center; }
        .video-container {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            border-radius: 12px;
            background-color: #000;
        }
        .video-container iframe {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            border: none;
        }
        .schedule-container {
            background-color: #112240;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
            border: 1px solid #1e3a5f;
        }
        .schedule-title { text-align: center; font-size: 1.5rem; margin-bottom: 20px; color: #a0c4ff; font-weight: 600; }
        .schedule-table { width: 100%; border-collapse: collapse; font-size: 1rem; }
        .schedule-table th {
            background-color: #1e3a5f;
            color: #ffffff;
            padding: 12px 15px;
            text-align: left;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            border-bottom: 2px solid #2a4a7a;
        }
        .schedule-table td { padding: 12px 15px; border-bottom: 1px solid #1e3a5f; }
        .time-cell { font-weight: 700; color: #ffd700; white-space: nowrap; min-width: 130px; }
        .show-cell { font-weight: 500; }
        .status {
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-block;
            min-width: 80px;
            text-align: center;
        }
        .status.active { background-color: #ff6b6b; color: white; }
        .status.upcoming { background-color: #2a4a7a; color: #a0c4ff; }
        .status.ended { background-color: #1a2f4a; color: #5a7a9a; }
        .notice { text-align: center; color: #5a7a9a; font-size: 0.85rem; margin-top: 15px; font-style: italic; }
        .footer { margin-top: 25px; font-size: 0.85rem; color: #5a7a9a; text-align: center; padding: 15px; }
        @media (max-width: 600px) {
            body { padding: 10px; }
            .header h1 { font-size: 1.5rem; }
            .schedule-table { font-size: 0.85rem; }
            .time-cell { min-width: 90px; font-size: 0.8rem; }
            .clock { font-size: 1rem; padding: 8px 15px; }
            .schedule-table th, .schedule-table td { padding: 8px 6px; }
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>MY <span>HOME</span> 📺</h1>
        <div class="clock" id="clock">00:00:00</div>
    </div>

    <div class="main-container">
        <div class="player-section">
            <div class="player-title" id="playerTitle">⏳ Загрузка...</div>
            <div class="video-container">
                <iframe id="videoFrame" src="" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="notice">🔒 Просмотр доступен только по расписанию</div>
        </div>

        <div class="schedule-container">
            <div class="schedule-title">📅 Расписание эфира</div>
            <table class="schedule-table">
                <thead><tr><th>Время</th><th>Мультфильм</th><th>Статус</th></tr></thead>
                <tbody id="scheduleBody"></tbody>
            </table>
        </div>
    </div>

    <div class="footer">MY HOME • Телеканал для детей</div>

    <script>
        var schedule = [
            { start: { h: 6, m: 0 }, end: { h: 7, m: 30 }, title: "Губка Боб Квадратные Штаны", videoId: "83gzUfs8VU4" },
            { start: { h: 7, m: 30 }, end: { h: 8, m: 0 }, title: "Три кота", videoId: "C4sX4HvxgmY" },
            { start: { h: 8, m: 0 }, end: { h: 9, m: 15 }, title: "Мими Мишки", videoId: "XEzMTmC1r1w" },
            { start: { h: 9, m: 15 }, end: { h: 10, m: 0 }, title: "Медведь Валера", videoId: "C6Z2Zuq74gg" },
            { start: { h: 10, m: 0 }, end: { h: 10, m: 30 }, title: "Ералаш", videoId: "PZSkHSWnu1g" },
            { start: { h: 10, m: 30 }, end: { h: 12, m: 0 }, title: "Маша и Медведь", videoId: "dL2O7GMG3xQ" },
            { start: { h: 12, m: 0 }, end: { h: 12, m: 30 }, title: "Приключения дельфинёнка Муму", videoId: "YwGxJJAIf80" },
            { start: { h: 12, m: 30 }, end: { h: 13, m: 15 }, title: "Барбоскины", videoId: "9CDdPPlsUkk" },
            { start: { h: 13, m: 15 }, end: { h: 14, m: 0 }, title: "Baby Shark", videoId: "kjCfzGzqlWA" },
            { start: { h: 14, m: 0 }, end: { h: 15, m: 0 }, title: "Простоквашино", videoId: "t9tcwoIEp5s" },
            { start: { h: 15, m: 0 }, end: { h: 17, m: 0 }, title: "Фиксики", videoId: "nyXgRvMxCQY" },
            { start: { h: 17, m: 0 }, end: { h: 18, m: 0 }, title: "Сказочный патруль", videoId: "jzarHfhHG8c" },
            { start: { h: 18, m: 0 }, end: { h: 19, m: 45 }, title: "Смешарики", videoId: "SOvrw-rysuQ" },
            { start: { h: 19, m: 45 }, end: { h: 21, m: 0 }, title: "Белка и Стрелка", videoId: "-0CD5-XMqvI" }
        ];

        function pad(n){return String(n).padStart(2,'0')}
        function timeToMinutes(h,m){return h*60+m}
        function formatTime(h,m){return pad(h)+":"+pad(m)}

        function updateClock(){
            var now = new Date();
            document.getElementById('clock').textContent = pad(now.getHours())+":"+pad(now.getMinutes())+":"+pad(now.getSeconds());
        }
        setInterval(updateClock, 1000);
        updateClock();

        function buildSchedule(){
            var html = '';
            schedule.forEach(function(item){
                var id = item.title.replace(/\s+/g,'-');
                html += '<tr><td class="time-cell">'+formatTime(item.start.h,item.start.m)+' – '+formatTime(item.end.h,item.end.m)+'</td><td class="show-cell">'+item.title+'</td><td><span class="status upcoming" id="status-'+id+'">Ожидание</span></td></tr>';
            });
            document.getElementById('scheduleBody').innerHTML = html;
        }
        buildSchedule();

        function playVideo(item){
            document.getElementById('playerTitle').textContent = '▶ Сейчас идёт: ' + item.title;
            var iframe = document.getElementById('videoFrame');
            iframe.src = 'https://www.youtube.com/embed/' + item.videoId + '?autoplay=1&playsinline=1';
            
            schedule.forEach(function(s){
                var id = s.title.replace(/\s+/g,'-');
                var el = document.getElementById('status-'+id);
                if(s.title === item.title){
                    el.textContent = '▶ Идёт';
                    el.className = 'status active';
                } else {
                    el.textContent = 'Ожидание';
                    el.className = 'status upcoming';
                }
            });
        }

        function checkSchedule(){
            var now = new Date();
            var nowMinutes = timeToMinutes(now.getHours(), now.getMinutes());
            
            for(var i = 0; i < schedule.length; i++){
                var item = schedule[i];
                var start = timeToMinutes(item.start.h, item.start.m);
                var end = timeToMinutes(item.end.h, item.end.m);
                
                if(nowMinutes >= start && nowMinutes < end){
                    playVideo(item);
                    return;
                }
            }
            
            document.getElementById('playerTitle').textContent = '⏸ Эфир завершён';
            document.getElementById('videoFrame').src = '';
        }
        
        checkSchedule();
        setInterval(checkSchedule, 60000);
    </script>

</body>
</html>
